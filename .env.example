# ─────────────────────────────────────────────────────────────────────────────
# Coles Shift Handover Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Staffbase API token
# Generate in Studio → Settings → Integrations → API Tokens
# Must have editorial access or higher. Only shown once — save it immediately.
STAFFBASE_API_TOKEN=your_base64_encoded_api_token_here

# Coles Space ID — confirmed
STAFFBASE_SPACE_ID=69cb058ab5da55011d7911a9

# Coles Staffbase instance — confirmed
STAFFBASE_BASE_URL=https://coles.staffbase.rocks/api

# Single store label used for all handovers (generic, no store ID logic)
STORE_LABEL=Coles Store
